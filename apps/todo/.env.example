# Notion credentials are server-only. A personal access token works for a
# single-workspace personal app; never expose it through a VITE_ variable.
NOTION_PAT=
NOTION_DATA_SOURCE_ID=3b1c711c-0ceb-80a2-8c62-000bae4f0170

# Required outside local development. Use long random values.
APP_PASSWORD=
SESSION_SECRET=

# Local ports. The web dev server proxies /api to the API server.
PORT=8790
WEB_ORIGIN=http://localhost:5174

# Explicit local-only convenience. Production refuses to start when enabled.
DEV_BYPASS_AUTH=true
